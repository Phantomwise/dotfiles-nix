export def list-env [] {
	^env | lines | parse "{name}={value}"
}

export def list-path [] {
    $env.PATH
}

export def --wrapped mkvpropedit-loop [...rest] {
    for f in (ls *.mkv | get name) {
        mkvpropedit $f ...$rest
    }
}

