#!/usr/bin/env nu

# AI Disclaimer: This script was been generated by a LLM.
#
# feed: run a command once per input line, sending the line to its stdin.
#
# usage:  open file.txt | lines | feed -- command arg1 arg2 ...
#         open file.txt | lines | feed --feed-log-dir ~/logs -- command arg1 ...
#
# - keeps going when a run fails
# - an interrupted run (exit code 130) stops the batch
# - returns a table of {line, status, code}
# - writes every non-ok row to failed-<timestamp>.csv (only if there are any)
#
# log directory, highest priority first:
#   1. --feed-log-dir <dir>   (must come before the `--`)
#   2. $env.FEED_LOG_DIR
#   3. LOG_DIR below

const LOG_DIR = "."

export def --wrapped main [
    --feed-log-dir: path   # directory for failed-*.csv logs
    ...cmd: string
] {
    let input = $in

    # validate input: must be a list of strings
    if not (($input | describe) =~ '^list') or not ($input | all {|l| ($l | describe) == "string" }) {
        error make { msg: "feed expects a list of lines, did you forget `| lines`?" }
    }

    # drop a literal leading `--` if it ended up in the rest args
    let cmd = if ($cmd | is-not-empty) and ($cmd | first) == "--" { $cmd | skip 1 } else { $cmd }
    if ($cmd | is-empty) {
        error make { msg: "feed needs a command, e.g. feed -- yt-dlp-wrapper.py --write-subs" }
    }
    let prog = $cmd | first
    let args = $cmd | skip 1

    # resolve the log directory: flag > env var > constant
    let log_dir = $feed_log_dir
        | default ($env.FEED_LOG_DIR? | default $LOG_DIR)
        | path expand

    # trim and drop blank lines
    let lines = $input | each {|l| $l | str trim } | where {|l| $l != "" }

    mut results = []
    for line in $lines {

        let code = try {
            $"($line)\n" | ^$prog ...$args
            0
        } catch {|e|
            let err = $e.json | from json
            if $err.code == "nu::shell::non_zero_exit_code" {
                $err.labels.0.text
                    | parse "exited with code {code}"
                    | get 0?.code?
                    | default 1
                    | into int
            } else {
                130
            }
        }

        let status = if $code == 0 { "ok" } else if $code == 130 { "interrupted" } else { "failed" }
        $results = ($results | append { line: $line, status: $status, code: $code })

        if $status == "interrupted" { break }
    }

    # everything after an interrupt never ran
    let rest = $lines
        | skip ($results | length)
        | each {|l| { line: $l, status: "not run", code: null } }
    let results = $results | append $rest

    # log the non-ok rows
    let failed = $results | where status != "ok"
    if ($failed | is-not-empty) {
        let stamp = date now | format date "%Y-%m-%d_%H-%M-%S"
        mkdir $log_dir
        $failed | save ($log_dir | path join $"failed-($stamp).csv")
    }

    $results
}
